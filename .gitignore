/target
/.wt
/.mcp.json
# wrangler's local state (dev sessions, deploy cache); never part of the repository.
/.wrangler/
# Rendered from docs/brand at deploy (scripts/site-render.mjs); the SVGs are the source.
/site/assets/*.png

# Vale: `vale sync` downloads proselint into styles/. Only styles/gitterrace is ours.
/styles/*
!/styles/gitterrace/
!/styles/Schwarzwald
.DS_Store

# Failure dumps from the equivalence oracle (debug output, never committed)
*.actual/

# Python and Node caches from scripts/ and lint tools
__pycache__/
.ruff_cache/
node_modules/

# Local denylist of names, hosts and ids (the shared lints in shared/schwarzwald/lint)
/.personal-denylist
