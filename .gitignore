# Build output, including a target dir with a suffix (a separate CARGO_TARGET_DIR for one run).
/target
/target-*/
/.wt
/.mcp.json
# wrangler's local state (dev sessions, deploy cache) beside each config; never part of the repository.
.wrangler/

# Vale: `vale sync` downloads proselint into schwarzwald/styles/. Only schwarzwald/styles/gitterrace is ours.
/schwarzwald/styles/*
!/schwarzwald/styles/gitterrace/
!/schwarzwald/styles/Schwarzwald
.DS_Store

# Failure dumps from the equivalence oracle (debug output, never committed)
*.actual/

# Python and Node caches from scripts/ and lint tools
__pycache__/
.ruff_cache/
node_modules/

# Local denylist of names, hosts and ids (the shared lints in vendor/schwarzwald/kit/lint)
/.personal-denylist

# Drawn from the run JSON by `make bench-report`; --check renders them in memory.
/tests/bench/results/**/*.svg
/tests/bench/results/**/README.md
