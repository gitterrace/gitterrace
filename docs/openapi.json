{
  "components": {
    "responses": {
      "Error": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Bad request, not found or server error. See `code`."
      }
    },
    "schemas": {
      "BlameItem": {
        "description": "The commit that last changed one line.",
        "properties": {
          "author": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          },
          "line_no": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "text": {
            "type": "string"
          },
          "time": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "author",
          "commit",
          "line_no",
          "text",
          "time"
        ],
        "type": "object"
      },
      "BlameResponse": {
        "description": "`GET /blame`.",
        "properties": {
          "commit": {
            "type": "string"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/BlameItem"
            },
            "type": "array"
          },
          "link": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": "string"
          },
          "permalink": {
            "type": [
              "string",
              "null"
            ]
          },
          "rev": {
            "type": "string"
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "commit",
          "lines",
          "path",
          "rev",
          "truncated"
        ],
        "type": "object"
      },
      "BlobResponse": {
        "description": "`GET /blob`. `text` and `total_lines` are null for a binary file.",
        "properties": {
          "binary": {
            "type": "boolean"
          },
          "commit": {
            "type": "string"
          },
          "link": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": "string"
          },
          "permalink": {
            "type": [
              "string",
              "null"
            ]
          },
          "rev": {
            "type": "string"
          },
          "size": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "total_lines": {
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "binary",
          "commit",
          "path",
          "rev",
          "size",
          "truncated"
        ],
        "type": "object"
      },
      "ChangeKind": {
        "enum": [
          "added",
          "modified",
          "deleted",
          "renamed"
        ],
        "type": "string"
      },
      "CommitResponse": {
        "description": "`GET /commits/{id}`.",
        "properties": {
          "author": {
            "$ref": "#/components/schemas/Signature"
          },
          "body": {
            "type": "string"
          },
          "committer": {
            "$ref": "#/components/schemas/Signature"
          },
          "files": {
            "items": {
              "$ref": "#/components/schemas/FileItem"
            },
            "type": "array"
          },
          "id": {
            "type": "string"
          },
          "link": {
            "type": [
              "string",
              "null"
            ]
          },
          "parents": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "permalink": {
            "type": [
              "string",
              "null"
            ]
          },
          "subject": {
            "type": "string"
          },
          "truncated": {
            "description": "The diff was cut at the line cap.",
            "type": "boolean"
          }
        },
        "required": [
          "author",
          "body",
          "committer",
          "files",
          "id",
          "parents",
          "subject",
          "truncated"
        ],
        "type": "object"
      },
      "ContributorItem": {
        "description": "One person with identities merged.",
        "properties": {
          "active_days": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "additions": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "bot": {
            "type": "boolean"
          },
          "commits": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "deletions": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "emails": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "first_commit": {
            "format": "int64",
            "type": "integer"
          },
          "first_time": {
            "description": "The first commit ever falls inside the counted window. Never for the whole history.",
            "type": "boolean"
          },
          "last_commit": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "series": {
            "description": "Commits per bucket.",
            "items": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          }
        },
        "required": [
          "active_days",
          "additions",
          "bot",
          "commits",
          "deletions",
          "emails",
          "first_commit",
          "first_time",
          "last_commit",
          "name",
          "series"
        ],
        "type": "object"
      },
      "ContributorsResponse": {
        "description": "`GET /contributors`.",
        "properties": {
          "authors": {
            "items": {
              "$ref": "#/components/schemas/ContributorItem"
            },
            "type": "array"
          },
          "bus_factor": {
            "description": "The fewest people who made half the commits.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "rev": {
            "type": "string"
          }
        },
        "required": [
          "authors",
          "bus_factor",
          "rev"
        ],
        "type": "object"
      },
      "DiffHunk": {
        "description": "A run of changed lines under one header.",
        "properties": {
          "header": {
            "type": "string"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/DiffLine"
            },
            "type": "array"
          }
        },
        "required": [
          "header",
          "lines"
        ],
        "type": "object"
      },
      "DiffLine": {
        "description": "One line of a diff hunk.",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/LineKind"
          },
          "new_no": {
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "old_no": {
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "text"
        ],
        "type": "object"
      },
      "EndpointDoc": {
        "description": "One endpoint, as `GET /` lists it.",
        "properties": {
          "params": {
            "items": {
              "$ref": "#/components/schemas/ParamDoc"
            },
            "type": "array"
          },
          "path": {
            "type": "string"
          },
          "returns": {
            "description": "The top-level fields of the answer.",
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "params",
          "path",
          "returns",
          "summary"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "enum": [
                  "bad_request",
                  "rev_not_found",
                  "path_not_found",
                  "needs_reindex",
                  "git",
                  "index",
                  "internal",
                  "index_unreadable",
                  "index_newer"
                ],
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "FileItem": {
        "description": "One file a commit changed.",
        "properties": {
          "additions": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "binary": {
            "type": "boolean"
          },
          "deletions": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "hunks": {
            "description": "Absent unless the request asked for the diff.",
            "items": {
              "$ref": "#/components/schemas/DiffHunk"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "kind": {
            "$ref": "#/components/schemas/ChangeKind"
          },
          "link": {
            "type": [
              "string",
              "null"
            ]
          },
          "old_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": "string"
          },
          "permalink": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "additions",
          "binary",
          "deletions",
          "kind",
          "path"
        ],
        "type": "object"
      },
      "IndexResponse": {
        "description": "`GET /`.",
        "properties": {
          "endpoints": {
            "items": {
              "$ref": "#/components/schemas/EndpointDoc"
            },
            "type": "array"
          },
          "insights": {
            "items": {
              "$ref": "#/components/schemas/InsightRow"
            },
            "type": "array"
          },
          "version": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "endpoints",
          "insights",
          "version"
        ],
        "type": "object"
      },
      "InsightList": {
        "description": "`GET /insights`.",
        "properties": {
          "insights": {
            "items": {
              "$ref": "#/components/schemas/InsightRow"
            },
            "type": "array"
          }
        },
        "required": [
          "insights"
        ],
        "type": "object"
      },
      "InsightRow": {
        "description": "One available insight.",
        "properties": {
          "name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "summary"
        ],
        "type": "object"
      },
      "LineKind": {
        "enum": [
          "context",
          "added",
          "removed"
        ],
        "type": "string"
      },
      "LogCommit": {
        "description": "One commit of a log page.",
        "properties": {
          "author": {
            "$ref": "#/components/schemas/Signature"
          },
          "committer": {
            "$ref": "#/components/schemas/Signature"
          },
          "id": {
            "type": "string"
          },
          "link": {
            "type": [
              "string",
              "null"
            ]
          },
          "parents": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "permalink": {
            "type": [
              "string",
              "null"
            ]
          },
          "subject": {
            "type": "string"
          }
        },
        "required": [
          "author",
          "committer",
          "id",
          "parents",
          "subject"
        ],
        "type": "object"
      },
      "LogResponse": {
        "description": "`GET /log`.",
        "properties": {
          "commits": {
            "items": {
              "$ref": "#/components/schemas/LogCommit"
            },
            "type": "array"
          },
          "has_more": {
            "type": "boolean"
          },
          "page": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "per_page": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "rev": {
            "type": "string"
          }
        },
        "required": [
          "commits",
          "has_more",
          "page",
          "per_page",
          "rev"
        ],
        "type": "object"
      },
      "ParamDoc": {
        "description": "One query parameter of an endpoint.",
        "properties": {
          "description": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "ty": {
            "type": "string"
          }
        },
        "required": [
          "description",
          "name",
          "required",
          "ty"
        ],
        "type": "object"
      },
      "RefItem": {
        "description": "One branch, tag or remote.",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/RefKind"
          },
          "name": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "time": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "name",
          "target",
          "time"
        ],
        "type": "object"
      },
      "RefKind": {
        "enum": [
          "branch",
          "tag",
          "remote"
        ],
        "type": "string"
      },
      "RefsResponse": {
        "description": "`GET /refs`.",
        "properties": {
          "refs": {
            "items": {
              "$ref": "#/components/schemas/RefItem"
            },
            "type": "array"
          }
        },
        "required": [
          "refs"
        ],
        "type": "object"
      },
      "RepoResponse": {
        "description": "`GET /repo`.",
        "properties": {
          "head": {
            "type": [
              "string",
              "null"
            ]
          },
          "head_branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "index_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "totals": {
            "$ref": "#/components/schemas/RepoTotals"
          }
        },
        "required": [
          "name",
          "totals"
        ],
        "type": "object"
      },
      "RepoTotals": {
        "description": "Commits, authors, files and lines over the whole history. Every field but `every_commits`\ncounts the counted commits.",
        "properties": {
          "additions": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "authors": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "commits": {
            "description": "The counted commits: no merges, bots as the options say.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "deletions": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "every_commits": {
            "description": "Every reachable commit, merges and bots included: the overview's \"N commits\".",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "files": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "additions",
          "authors",
          "commits",
          "deletions",
          "every_commits",
          "files"
        ],
        "type": "object"
      },
      "Signature": {
        "description": "Who did something and when.",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "offset": {
            "description": "Offset from UTC in seconds.",
            "format": "int32",
            "type": "integer"
          },
          "time": {
            "description": "Seconds since the Unix epoch.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "email",
          "name",
          "offset",
          "time"
        ],
        "type": "object"
      },
      "TreeEntryKind": {
        "enum": [
          "dir",
          "file",
          "symlink",
          "submodule"
        ],
        "type": "string"
      },
      "TreeItem": {
        "description": "One entry of a directory.",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/TreeEntryKind"
          },
          "name": {
            "type": "string"
          },
          "size": {
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "kind",
          "name"
        ],
        "type": "object"
      },
      "TreeResponse": {
        "description": "`GET /tree`.",
        "properties": {
          "commit": {
            "type": "string"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/TreeItem"
            },
            "type": "array"
          },
          "path": {
            "type": "string"
          },
          "rev": {
            "type": "string"
          }
        },
        "required": [
          "commit",
          "entries",
          "path",
          "rev"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Read-only and local. Every answer is pinned to a revision (`rev`, default `HEAD`). Each repository's API lives at `/r/{name}/api/v1`.",
    "license": {
      "identifier": "MIT",
      "name": "MIT"
    },
    "title": "gitterrace API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "index",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndexResponse"
                }
              }
            },
            "description": "endpoints, insights, version",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "Not modified (`If-None-Match` matched the `ETag`)."
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "Endpoint and insight list."
      }
    },
    "/blame": {
      "get": {
        "operationId": "blame",
        "parameters": [
          {
            "description": "Revision to read, default `HEAD`.",
            "in": "query",
            "name": "rev",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "File to blame.",
            "in": "query",
            "name": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BlameResponse"
                }
              }
            },
            "description": "commit, lines, link, path, permalink, rev, truncated",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "Not modified (`If-None-Match` matched the `ETag`)."
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "Per-line authorship."
      }
    },
    "/blob": {
      "get": {
        "operationId": "blob",
        "parameters": [
          {
            "description": "Revision to read, default `HEAD`.",
            "in": "query",
            "name": "rev",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "File to read.",
            "in": "query",
            "name": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "First line of the window, 1-based, default `1`.",
            "in": "query",
            "name": "start_line",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Lines in the window, at most `api.blob_lines`.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BlobResponse"
                }
              }
            },
            "description": "binary, commit, link, path, permalink, rev, size, text, total_lines, truncated",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "Not modified (`If-None-Match` matched the `ETag`)."
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "summary": "File text at a revision."
      }
    },
    "/commits/{id}": {
      "get": {
        "operationId": "commits_id",
        "parameters": [
          {
            "description": "A commit id or any revision git understands.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Include hunks, default `true`.",
            "in": "query",
            "name": "diff",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "Most diff lines, at most `api.diff_lines`.",
            "in": "query",
            "name": "max_lines",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
