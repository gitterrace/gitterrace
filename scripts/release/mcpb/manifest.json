{
  "manifest_version": "0.3",
  "name": "gitterrace",
  "display_name": "gitterrace",
  "version": "@VERSION@",
  "description": "Read-only git browser with insights, served to agents over MCP.",
  "author": {
    "name": "gitterrace",
    "url": "https://gitterrace.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gitterrace/gitterrace"
  },
  "homepage": "https://gitterrace.dev",
  "license": "MIT",
  "server": {
    "type": "binary",
    "entry_point": "server/git-terrace",
    "mcp_config": {
      "command": "${__dirname}/server/git-terrace",
      "args": ["mcp"],
      "platform_overrides": {
        "win32": {
          "command": "${__dirname}/server/git-terrace.exe"
        }
      }
    }
  },
  "compatibility": {
    "platforms": ["darwin", "win32", "linux"]
  }
}
