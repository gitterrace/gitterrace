# The shared skills and agents read what they vary on from here: data only.
HARNESS_PRODUCT="gitterrace"
HARNESS_GATE_CHEAP="sh scripts/land-check.sh --base main"
HARNESS_GATE_STEPS="make names lines / never;;make fmt clippy / no Rust change;;make lint / never;;make docs-check / never;;python3 vendor/schwarzwald/kit/tools/golden.py change main HEAD / no web change;;scripts/land-check.sh --base main / never"
HARNESS_GATE_LINT_ALL="make check"
HARNESS_GENERATE="make docs-gen"
HARNESS_CHECK_GENERATED="make docs-check"
HARNESS_DOCS_REGISTRY=""
HARNESS_SOURCE_DIRS="crates scripts xtask"
HARNESS_SHOT="make site-shots"
HARNESS_UI_SMOKE="node scripts/verify/browser/browser-check.mjs --bin target/release/git-terrace"
HARNESS_BUILD_LOCK=""
HARNESS_DETACH=""
HARNESS_LANE_ACCEPT="python3 scripts/lint/commits-check.py"
HARNESS_ATTRIBUTE_LINT=""
HARNESS_ROUTER_MAP=""
HARNESS_MERGE_REVERTS=""
HARNESS_HOT_PATHS="crates/gitterrace-web/src/app/refresh.rs: the watcher loop and live streams;;crates/gitterrace-index/src/feed: the index store and its readers"
HARNESS_BOARD_PROJECT="gitterrace"
HARNESS_BOARD_CLI="tendir"
HARNESS_BOARD_MCP="tendir_thread"
HARNESS_LANE_FORBIDDEN="vendor/schwarzwald/kit"
HARNESS_BRIEFS=""
HARNESS_LANE_ENV=""
HARNESS_MISC_VERIFY="python3 vendor/schwarzwald/kit/tools/golden.py change main HEAD"
