# gitterrace's guard config, read by shared/schwarzwald/guards/config.sh with bash builtins. Data
# only: each line is NAME="${NAME:-literal}", so a case or a session may set one value for one
# command. Every key and what it means: shared/schwarzwald/guards/config.example.env.
# gitterrace has no rules of its own: every guard is a shared rule with these values.

GUARD_PRODUCT="${GUARD_PRODUCT:-gitterrace}"
GUARD_APP_RE="${GUARD_APP_RE:-[Gg]itterrace|git-terrace}"
GUARD_SPOOL_NAME="${GUARD_SPOOL_NAME:-gitterrace-guard-spool}"
GUARD_SCRATCH_ROOTS="${GUARD_SCRATCH_ROOTS:-$HOME/.jcode/scratch}"
GUARD_OPUS_CLASS_RE="${GUARD_OPUS_CLASS_RE:-cache format|store format|on-disk format|index invariant|golden|oracle|re-?bless|security|irreversible|history rewrite|force.?push|delete|publish|release tag|tagging|coordination|architecture}"
GUARD_OPUS_CLASS_NAMES="${GUARD_OPUS_CLASS_NAMES:-cache or store format, index invariants, golden or oracle acceptance (re-bless review), security, an irreversible call (history rewrite, deletes, publish or tag), coordination or architecture}"
GUARD_PROTECTED_GLOBS="${GUARD_PROTECTED_GLOBS:-*/static/vendor/* */tests/golden/* */docs/api.md */docs/configuration.md */docs/openapi.json}"
GUARD_PROTECTED_HINT="${GUARD_PROTECTED_HINT:-Vendor: update from the upstream release. Golden: regenerate with TEST_BLESS=1 cargo test -p <crate> --test <name>. Docs: change the registry, then make docs-gen.}"
GUARD_GENERATED_FEEDS="${GUARD_GENERATED_FEEDS:-*/Makefile */Cargo.toml */xtask/src/* */scripts/*.sh */scripts/*.py */scripts/*.mjs}"
GUARD_GENERATED_HINT="${GUARD_GENERATED_HINT:-It feeds a generated block or page (AGENTS.md, README, docs/api.md, docs/configuration.md): regenerate with make docs-gen and confirm with make docs-check.}"
GUARD_WORKTREE_DIR="${GUARD_WORKTREE_DIR:-.wt}"
GUARD_LANE_ENV="${GUARD_LANE_ENV:-GITTERRACE_LANE}"
GUARD_LANE_ROLES="${GUARD_LANE_ROLES:-.runs/lane-roles}"
GUARD_WRITE_CMDS_RE="${GUARD_WRITE_CMDS_RE:-}"
GUARD_BUILD_TARGETS_RE="${GUARD_BUILD_TARGETS_RE:-check|test|build|bench}"
GUARD_LONG_TARGETS_RE="${GUARD_LONG_TARGETS_RE:-check|test|bench|lint}"
GUARD_DETACHED_RE="${GUARD_DETACHED_RE:-}"
GUARD_BUILD_LOCK_ENV="${GUARD_BUILD_LOCK_ENV:-GITTERRACE_BUILD_LOCK}"
GUARD_MAKE_HINT="${GUARD_MAKE_HINT:-make check / make test}"
GUARD_PRODUCT_RULE_DIRS="${GUARD_PRODUCT_RULE_DIRS:-}"
GUARD_PRODUCT_RULE_FILES="${GUARD_PRODUCT_RULE_FILES:-0}"
GUARD_PRODUCT_CASES="${GUARD_PRODUCT_CASES:-scripts/guards/tests/cases-gitterrace.sh}"
GUARD_PRODUCT_PROBES="${GUARD_PRODUCT_PROBES:-scripts/guards/tests/red-probes.tsv}"
MAIN_CHECKOUT_LANDS_ONLY="${MAIN_CHECKOUT_LANDS_ONLY:-1}"
