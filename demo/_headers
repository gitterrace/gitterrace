# Headers for demo.gitterrace.dev, copied into the export by scripts/site-export.sh.
# The export is the app's own HTML, so this mirrors the app's policy: scripts and styles from
# this origin only. The demo is read-only: no actions, no live updates, no API.
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Robots-Tag: noindex

/static/*
  Cache-Control: public, max-age=3600
