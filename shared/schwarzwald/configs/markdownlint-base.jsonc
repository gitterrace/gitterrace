// The markdownlint rules every product shares. markdownlint-cli2 reads one config, so each
// product's .markdownlint-cli2.jsonc carries this "config" block and adds its own rules beside it.
{
  "config": {
    "default": true,
    "MD013": false,
    "MD003": { "style": "atx" },
    "MD004": { "style": "dash" },
    "MD049": { "style": "underscore" },
    "MD050": { "style": "asterisk" },
    "MD046": { "style": "fenced" },
    "MD040": true,
    "MD022": true,
    "MD031": { "list_items": false },
    "MD038": false,
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD034": false,
    "MD036": false,
    "MD060": false,
    // Prose width, from shared/schwarzwald/configs/markdownlint/prose-length.cjs. Each product sets
    // its limit here and lists the rule in "customRules".
    "prose-length": { "line_length": 80 }
  }
}
