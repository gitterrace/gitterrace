# The guard config of a product, at <product>/config/schwarzwald/guards.env. Data only, read by
# guards/config.sh with bash builtins: each line is NAME='literal' (sets the value) or
# NAME="${NAME:-literal}" (keeps a value the environment already has). A literal may hold
# $HOME, nothing else expands. A line of any other shape, or a key not listed here, makes the
# engine give no verdict, and the adapters then degrade loudly.
#
# This file is the example the shared selftest runs against, and it lists every key the guards
# read: build.py --check fails when the code reads a key this file does not state.

# The name in every warning, so a reader knows whose guards spoke.
GUARD_PRODUCT="${GUARD_PRODUCT:-example}"
# The app a synthetic keystroke must never be aimed at. An ERE.
GUARD_APP_RE="${GUARD_APP_RE:-[Ee]xample[Aa]pp}"
# The directory under $TMPDIR an advisory is spooled to, per session.
GUARD_SPOOL_NAME="${GUARD_SPOOL_NAME:-example-guard-spool}"
# Agent scratch roots containment treats like $TMPDIR: absolute, literal, space-separated.
# A root that is $HOME, above it, relative or holding .. is ignored.
GUARD_SCRATCH_ROOTS="${GUARD_SCRATCH_ROOTS:-$HOME/.jcode/scratch}"
# The classes that justify an Opus lane, as one ERE over the lowercased brief, and the same
# list in prose for the block message.
GUARD_OPUS_CLASS_RE="${GUARD_OPUS_CLASS_RE:-schema|migration|migrator|sync|crypto|security|irreversible}"
GUARD_OPUS_CLASS_NAMES="${GUARD_OPUS_CLASS_NAMES:-schema, migration, sync, crypto, security or an irreversible call}"
# Files no agent edits by hand: generated, vendored or golden. Space-separated globs over the
# absolute path, and the remedy the block names. Secrets and the shared copy are always refused.
GUARD_PROTECTED_GLOBS="${GUARD_PROTECTED_GLOBS:-*/docs/generated/* */vendor/* */tests/golden/*}"
GUARD_PROTECTED_HINT="${GUARD_PROTECTED_HINT:-Edit the source of truth and regenerate: make generate}"
# Files that feed a generated file, and the command that regenerates it.
GUARD_GENERATED_FEEDS="${GUARD_GENERATED_FEEDS:-*/Makefile */Cargo.toml */xtask/src/*}"
GUARD_GENERATED_HINT="${GUARD_GENERATED_HINT:-Regenerate with make generate and confirm with make generate-check.}"
# Where worktrees live, relative to the checkout.
GUARD_WORKTREE_DIR="${GUARD_WORKTREE_DIR:-.wt}"
# The product's own name for the lane variable (ro or rw), read into GUARD_LANE, and the file
# the coordinator writes session roles to (relative to the product root, or absolute).
GUARD_LANE_ENV="${GUARD_LANE_ENV:-EXAMPLE_LANE}"
GUARD_LANE_ROLES="${GUARD_LANE_ROLES:-.runs/lane-roles}"
# The product CLI's write verbs, an ERE in command position: a write piped into tail, or fed
# an empty $(cat f), is reported. Empty means the product has no such CLI.
GUARD_WRITE_CMDS_RE="${GUARD_WRITE_CMDS_RE:-example[[:space:]]+(add|edit|delete)}"
# make targets that build or test (cargo lock contention), and those that run long.
GUARD_BUILD_TARGETS_RE="${GUARD_BUILD_TARGETS_RE:-check|test|build}"
GUARD_LONG_TARGETS_RE="${GUARD_LONG_TARGETS_RE:-check|test|lint}"
# A command that already detaches a long run, an ERE. Empty means the harness flag only.
GUARD_DETACHED_RE="${GUARD_DETACHED_RE:-bg-run\.sh}"
# The variable the product's build lock exports while it holds the lock, and the make targets
# a bare workspace cargo run is pointed at.
GUARD_BUILD_LOCK_ENV="${GUARD_BUILD_LOCK_ENV:-EXAMPLE_BUILD_LOCK}"
GUARD_MAKE_HINT="${GUARD_MAKE_HINT:-make check / make test}"
# The product's own rules: directories of *.sh relative to the product root, loaded after the
# shared ones, and how many files they hold (a missing one makes the install INCOMPLETE).
GUARD_PRODUCT_RULE_DIRS="${GUARD_PRODUCT_RULE_DIRS:-}"
GUARD_PRODUCT_RULE_FILES="${GUARD_PRODUCT_RULE_FILES:-0}"
# The product's cases for those rules (sourced by the selftest) and its red probes (a
# red-probes.tsv of its own), relative to the product root.
GUARD_PRODUCT_CASES="${GUARD_PRODUCT_CASES:-}"
GUARD_PRODUCT_PROBES="${GUARD_PRODUCT_PROBES:-}"
