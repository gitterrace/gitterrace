#!/usr/bin/env bash
# Commit-msg: the subject reads `type(scope): subject` (CONV-COMMIT-SUBJECT), and subject and body
# pass CONV-NO-INTERNAL-REFS, CONV-PERSONAL-DATA and CONV-NO-OWN-SHAS. Lines git strips (starting
# with `#`) are skipped. Types and the override prefix come from the product's
# config/schwarzwald/lint.toml. The product's landing gate runs the same lints on every commit
# it lands, so the hook is a convenience, never the only gate.
#
# A product keeps a one-line shim in its hooks dir that execs this file, so core.hooksPath
# stays one dir:   exec "$(git rev-parse --show-toplevel)/shared/schwarzwald/hooks/commit-msg" "$@"
set -euo pipefail
lint="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lint" && pwd)"
root="${COMMIT_MSG_REPO:-$(git rev-parse --show-toplevel)}"

# The lints need tomllib: the first python3 that is 3.11 or newer.
py=""
for c in python3 python3.15 python3.14 python3.13 python3.12 python3.11; do
  if command -v "$c" >/dev/null && "$c" -c 'import sys; sys.exit(sys.version_info < (3, 11))'; then
    py=$c
    break
  fi
done
[[ -n $py ]] || { echo "commit-msg: needs python 3.11 or newer" >&2; exit 1; }

"$py" "${lint}/commit-subject.py" --repo "${root}" --message "$1" >&2 || exit 1
rc=0
for rule in internal-refs personal-data own-shas; do
  out=$("$py" "${lint}/${rule}.py" --repo "${root}" --message "$1" 2>&1) || { printf '%s\n' "${out}" >&2; rc=1; }
done
exit "${rc}"
