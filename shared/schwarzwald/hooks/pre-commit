#!/usr/bin/env bash
# Opt-in: with MAIN_CHECKOUT_LANDS_ONLY=1 in config/schwarzwald/guards.env, the main (non-worktree)
# checkout refuses a commit unless the land tool's stamp LAND_TOOL=1 is in the environment.
# Linked worktrees and products without the flag are never refused.
set -euo pipefail
top=$(git rev-parse --show-toplevel)
env_file="$top/config/schwarzwald/guards.env"
[[ -f $env_file ]] || exit 0
# Read through the guards' own loader, so every spelling the config shape allows counts.
# shellcheck source=/dev/null
. "$(dirname "${BASH_SOURCE[0]}")/../guards/config.sh" || { echo "pre-commit: cannot load guards/config.sh beside it" >&2; exit 1; }
guard_config_value "$env_file" MAIN_CHECKOUT_LANDS_ONLY
[[ $GUARD_CONFIG_VALUE == 1 ]] || exit 0
[[ $(git rev-parse --git-dir) == "$(git rev-parse --git-common-dir)" ]] || exit 0
[[ ${LAND_TOOL:-} == 1 ]] && exit 0
echo "pre-commit: refused. This checkout takes landings only (MAIN_CHECKOUT_LANDS_ONLY=1): commit in a worktree and land it with land.sh." >&2
exit 1
