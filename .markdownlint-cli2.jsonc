{
  // markdownlint checks list and emphasis style, fenced code languages and prose width. Prose
  // wraps at 100 columns (scripts/markdownlint/prose-length.cjs); code spans, tables, fences,
  // headings and link definitions are exempt, since they cannot wrap. Rewrap hand-written prose
  // with `npx prettier --prose-wrap always --print-width 100 --write FILE`, then `make docs-gen`.
  "config": {
    "default": true,
    "MD013": false,
    "MD003": { "style": "atx" },
    "MD004": { "style": "dash" },
    "MD049": { "style": "underscore" },
    "MD050": { "style": "asterisk" },
    "MD046": { "style": "fenced" },
    "MD040": true,
    "MD022": true,
    "MD031": { "list_items": false },
    "MD038": false,
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD034": false,
    "MD036": false,
    "MD060": false
  },
  "customRules": ["./scripts/markdownlint/prose-length.cjs"],
  // Every markdown file in the tree, so a new page is linted without a list to update. Only
  // vendored and generated-elsewhere trees are left out.
  "globs": ["**/*.md"],
  "ignores": [
    "target/**", "node_modules/**", "shared/schwarzwald/**", "site/**",
    // vale downloads its packages here (gitignored)
    "styles/proselint/**"
  ]
}
